# Kopiera till .env och fyll i. .env ligger i .gitignore.
# Den här filen innehåller bara tomma platshållare, aldrig riktiga värden.

# Servern
PORT=3000

# Supabase (projektets adress och HEMLIGA nyckel; nyckeln hämtas i Supabase-dashboarden)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Kryptering av e-post (två olika nycklar, 32 slumpmässiga byte som hex)
# Skapa t.ex. med: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_ENCRYPTION_KEY=
EMAIL_HASH_KEY=

# Inloggningscookie: livslängd i dagar
SESSION_DAYS=30

# Läggs till i steg 13 (e-post): RESEND_API_KEY, SMTP-uppgifter
